rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media objects are isolated by authenticated user ID
    match /users/{userId}/{allPaths=**} {
      // Only the authenticated owner can read their stored media
      allow read: if request.auth != null && request.auth.uid == userId;

      // Only the authenticated owner can upload, with strict size and MIME type constraints
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024 // 20 MB max file size
                   && request.resource.contentType.matches('image/.*|video/.*');

      // Only the authenticated owner can delete their stored media
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny access to any paths outside of the scoped user directories
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
