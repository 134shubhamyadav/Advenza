# ─── BACKEND ENVIRONMENT VARIABLES (backend/.env.example) ───────────────────
# Server Port (Default: 5000)
PORT=5000

# MongoDB Connection String (Atlas or local instance)
MONGODB_URI=mongodb://localhost:27017/Advenza

# Groq API Key (Primary LLM Engine for itinerary & Plan B generation)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key (Fallback LLM Engine)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# WeatherAPI.com API Key (For live weather forecast & Risk Radar safety alerts)
VITE_WEATHER_API_KEY=your_weather_api_key_here

# Firebase Service Account JSON (One-line JSON string for production Auth. Leave empty in dev for bypass mode)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Redis & Queue Configuration (Optional in local development; required in production)
# Set SKIP_REDIS=true to run purely on local in-memory fallbacks without starting Redis
SKIP_REDIS=true
# REDIS_URL=redis://default:password@localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

