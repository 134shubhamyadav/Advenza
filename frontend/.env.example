# ─── FRONTEND ENVIRONMENT VARIABLES (.env.example) ──────────────────────────
# Optional: Production Backend Base URL (Leave empty in local dev to use Vite dev-server proxy on port 3000)
VITE_BACKEND_URL=

# Optional: Google Maps API Key for Maps & Location Search
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional: Weather API Key if accessed directly on frontend
VITE_WEATHER_API_KEY=your_weather_api_key_here
